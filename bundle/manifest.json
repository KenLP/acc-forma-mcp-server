{
  "manifest_version": "0.3",
  "name": "bimlynx",
  "display_name": "BIMLynx — Autodesk Construction Cloud",
  "version": "0.1.4",
  "description": "Connects Claude to Autodesk Construction Cloud (ACC/Forma) projects: issues, model data, clash detection, and document review, through the hosted BIMLynx MCP endpoint.",
  "long_description": "BIMLynx bridges Claude to your Autodesk Construction Cloud (ACC/Forma) projects. Every write action is dry-run by default, requires explicit approval, and is recorded in a tamper-evident audit log. This connector talks to the hosted BIMLynx service (mcp.bimlynx.com) using a bearer key issued per organization — no local server setup or Autodesk credentials are stored on this machine.",
  "author": {
    "name": "BIMLynx",
    "email": "hello@bimlynx.com",
    "url": "https://bimlynx.com"
  },
  "homepage": "https://bimlynx.com",
  "support": "mailto:hello@bimlynx.com",
  "license": "MIT",
  "keywords": [
    "autodesk",
    "acc",
    "forma",
    "bim",
    "construction",
    "aps"
  ],
  "privacy_policies": [
    "https://github.com/KenLP/acc-forma-mcp-server/blob/main/PRIVACY.md"
  ],
  "server": {
    "type": "node",
    "entry_point": "server/node_modules/mcp-remote/dist/proxy.js",
    "mcp_config": {
      "command": "node",
      "args": [
        "${__dirname}/server/node_modules/mcp-remote/dist/proxy.js",
        "https://mcp.bimlynx.com/mcp",
        "--header",
        "Authorization:${AUTH_TOKEN}",
        "--transport",
        "http-only"
      ],
      "env": {
        "AUTH_TOKEN": "Bearer ${user_config.bearer_key}"
      }
    }
  },
  "compatibility": {
    "claude_desktop": ">=0.10.0",
    "platforms": ["darwin", "win32", "linux"],
    "runtimes": {
      "node": ">=18.0.0"
    }
  },
  "user_config": {
    "bearer_key": {
      "type": "string",
      "title": "BIMLynx bearer key",
      "description": "Issued per organization — contact hello@bimlynx.com",
      "sensitive": true,
      "required": true
    }
  }
}
